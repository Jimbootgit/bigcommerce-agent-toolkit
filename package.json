{
  "name": "bigcommerce-agent-toolkit",
  "version": "0.1.0-alpha",
  "description": "Read-first BigCommerce MCP and CLI with approval-gated mutations",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jimbootgit/bigcommerce-agent-toolkit.git"
  },
  "type": "module",
  "files": [
    "src/",
    "README.md",
    "SCOPES.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/server.mjs",
    "./client": "./src/client.mjs",
    "./resources": "./src/resources.mjs",
    "./proposals": "./src/proposals.mjs"
  },
  "bin": {
    "bcat": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/client.mjs && node --check src/docs.mjs && node --check src/resources.mjs && node --check src/proposals.mjs && node --check src/server.mjs && node --check src/cli.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^3.25.76"
  }
}
